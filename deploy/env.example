# tg-bot: переменные окружения. Ровно те, что читает код (таблица - README, раздел "Настройки").
# Скопировать в /opt/tg-bot/.env на сервере, заполнить реальными значениями,
# затем: chmod 600 /opt/tg-bot/.env
# Реальные секреты в git не коммитить - этот файл только пример.
#
# На сервере файл читает systemd (EnvironmentFile в юните). Кроме того, бот сам
# добирает не заданные в окружении переменные из файлов по списку: ./.env,
# /opt/tg-bot/.env, ~/.env - слева направо, действует первое найденное
# значение. Окружение процесса сильнее файла. Исключение - TGBOT_LOGS_DIR,
# TGBOT_LOGS_MAX_BYTES, TGBOT_LOCK_PATH, TGBOT_LOG_LEVEL: их бот берёт только из
# окружения процесса (на сервере его заполняет тот же EnvironmentFile).
#
# Другой каталог бота: путь /opt/tg-bot/.env в списке заменяет TGBOT_ENV_FILE.
# Её задают в окружении процесса (export TGBOT_ENV_FILE=/srv/my-bot/.env),
# а не в этом файле: чтобы найти файл, путь нужен до его чтения. Юниту она не
# нужна - systemd и так грузит файл через EnvironmentFile.

# --- обязательное -------------------------------------------------------

# Токен бота из @BotFather (/newbot). ВАЖНО: для разработки - отдельный тестовый
# бот, прод-токен только на сервере. Один токен = один поллер: если прод-токен
# запустить локально одновременно с сервером, апдейты будут случайно доставаться
# то локальному процессу, то серверному.
TELEGRAM_BOT_TOKEN=

# user_id администраторов Telegram через запятую (пробелы допустимы).
# Узнать свой user_id: команда /whoami в личке с ботом.
ADMIN_USER_IDS=123456789,987654321

# Бот только для себя: 1 - пускает лишь ADMIN_USER_IDS, allowlist и
# /request_access выключены, чужим бот молчит. Пустой ADMIN_USER_IDS роняет старт.
# TGBOT_OWNER_ONLY=1

# Файл SQLite с allowlist, сессиями и журналом событий. Создаётся при первом
# старте. По умолчанию ./tgbot.db.
TGBOT_DB_PATH=/opt/tg-bot/data/tgbot.db

# --- Справка: что бот знает ---------------------------------------------

# Имя продукта, о котором отвечает Справка (в промптах модели). Пусто -
# "этот продукт" / "this product" на языке ответа.
# TGBOT_PRODUCT_NAME=

# Каталоги, которые агент Справки читает инструментами (только чтение), через
# запятую; относительные - от рабочего каталога бота. По умолчанию docs.
TGBOT_KNOWLEDGE_DIRS=docs

# Git-репозиторий с кодом и документацией продукта (необязательно). Бот клонирует
# его рядом с базой (каталог repo рядом с TGBOT_DB_PATH, здесь -
# /opt/tg-bot/data/repo) при старте и обновляет (git pull) перед ответом
# Справки; клон тоже читается агентом. Клон не появился - бот НЕ падает:
# ответы только по TGBOT_KNOWLEDGE_DIRS, причина - WARNING в journalctl и
# запись repo_pull_failed в журнале SQLite.
# Приватному репозиторию нужен один из двух вариантов доступа:
#   1) deploy key (read-only) в ~tg-bot/.ssh/id_ed25519 и ssh-URL - рекомендуется:
#      TGBOT_REPO_URL=git@github.com:<org>/<repo>.git
#   2) read-only токен в URL (fine-grained PAT, права Contents: Read, только этот репозиторий):
#      TGBOT_REPO_URL=https://<token>@github.com/<org>/<repo>
#      Бот передаёт токен git заголовком через окружение: в argv и в .git/config
#      клона его нет (клон читает агент), в логах он замаскирован. Клон,
#      созданный старой версией с токеном в URL, удалить (каталог repo) - бот
#      склонирует заново. Файл .env обязан быть chmod 600 - токен в нём открытым текстом.
# Допустимые формы: https://, ssh://, file://, git@host:path; http:// и значение
# с ведущим "-" роняют старт.
# Бот запускает git неинтерактивно (GIT_TERMINAL_PROMPT=0, BatchMode=yes):
# без готовых учётных данных git сразу падает с ошибкой, а не ждёт ввода.
# TGBOT_REPO_URL=

# --- модели (OpenRouter) ------------------------------------------------

# Ключ с openrouter.ai/settings/keys. Ступень одна - OpenRouter (ADR-0004).
# Ключа нет или провайдер отказал - бот работает, но на вопрос отвечает отказом
# с кодом инцидента.
OPENROUTER_API_KEY=

# Лестница моделей: СПИСОК через запятую, первая - основная, остальные -
# запасные. Запасную подключает сам бот, параллельно основной: по порогу
# времени или сразу после брака/ошибки предыдущей (ADR-0003). Потолок
# провайдера - 3 модели, список длиннее роняет старт. Пусто - z-ai/glm-5.3-flash.
OPENROUTER_MODEL=z-ai/glm-5.3-flash,openai/gpt-6-luna,deepseek/deepseek-v4.1-flash

# Пороги лестницы по классам вызова, секунды: вторая модель, третья, сбой.
# Три возрастающих положительных числа; опечатка роняет старт.
# По умолчанию full и reference - 120,240,600, light (болтовня) - 20,40,60.
# TGBOT_LLM_FULL_STEPS_S=120,240,600
# TGBOT_LLM_REFERENCE_STEPS_S=120,240,600
# TGBOT_LLM_LIGHT_STEPS_S=20,40,60

# Распознавание скриншотов (ADR-0005): основная и запасная модель через тот же
# OPENROUTER_API_KEY. Пусто - google/gemini-3.1-flash-lite,google/gemini-3.8-flash.
# Варианты :free запрещены (роняют старт): их провайдеры обучаются на запросах.
TGBOT_VISION_MODELS=

# Ступень LLM: openrouter (по умолчанию) или omniroute; другое роняет старт.
TGBOT_LLM_PROVIDER=openrouter

# --- модели (OmniRoute, вместо OpenRouter) ------------------------------
# Свой шлюз OmniRoute (github.com/diegosouzapw/OmniRoute). Включается
# TGBOT_LLM_PROVIDER=omniroute; адрес - TGBOT_LLM_BASE_URL (по умолчанию
# http://localhost:20128/v1). Модели - именами шлюза (префикс провайдера или
# combo), до трёх, первая основная; пусто при omniroute роняет старт.
# Скриншоты идут через шлюз тем же ключом: задайте TGBOT_VISION_MODELS его
# именами, запасная модель скриншотов не используется (делайте combo).
# OMNIROUTE_API_KEY=
# OMNIROUTE_MODEL=if/qwen3.8-max-preview
# TGBOT_LLM_BASE_URL=http://localhost:20128/v1

# Ключ классификатора Jev (typesafe.ai): пограничные случаи выродившегося ответа
# и намерение вопроса (болтовня, просьба о режиме). Без ключа из проверки на
# вырождение остаются регулярки, а кнопки перехода по просьбе словами нет.
# TYPESAFE_API_KEY=

# TTL кэша ответов агента в секундах (SQLite). По умолчанию 86400 (сутки).
# 0 - кэш выключен.
TGBOT_AGENT_CACHE_TTL_S=86400

# Окно (сек), в которое сообщения подряд склеиваются в одну пачку и получают
# один ответ. По умолчанию 2.0; 0 - без пачек.
TGBOT_TEXT_DEBOUNCE_S=2.0

# Напоминание админам о непрочитанных отзывах: пн-пт в этот час по этому поясу.
# Пояс - имя IANA (Europe/Berlin), час - 0-23. Опечатка роняет старт.
# TGBOT_REMINDER_TZ=Asia/Almaty
# TGBOT_REMINDER_HOUR=15

# --- журнал и процесс ---------------------------------------------------

# Каталог файлового журнала (JSONL по сессиям + bot.jsonl). По умолчанию ./logs
# (от WorkingDirectory юнита - /opt/tg-bot/logs).
# TGBOT_LOGS_DIR=./logs

# Потолок суммарного размера каталога журнала, целое число байт. По умолчанию
# 1073741824 (1 ГиБ). Не целое число (например 1G) роняет старт.
# TGBOT_LOGS_MAX_BYTES=1073741824

# Файл блокировки "один экземпляр бота". По умолчанию - TGBOT_DB_PATH с
# расширением .lock.
# TGBOT_LOCK_PATH=

# Уровень журнала процесса (stderr -> journald): DEBUG, INFO, WARNING, ERROR.
# Каждая строка несёт [u=<user> upd=<update>]; токен и ключи маскируются.
# TGBOT_LOG_LEVEL=INFO

# --- для тестов ----------------------------------------------------------

# Адрес Bot API. В проде не задавать (https://api.telegram.org/bot).
# Тестовое окружение Telegram (tests_e2e): https://api.telegram.org/bot{token}/test
# TELEGRAM_BOT_API_BASE_URL=

# Префикс OpenAI-совместимого API - ВКЛЮЧАЯ /v1 (например
# http://127.0.0.1:9000/api/v1); к нему дописывается /chat/completions,
# /responses, /generation. В проде задают только для OmniRoute (см. выше).
# TGBOT_LLM_BASE_URL=

# Токен для git pull в deploy/update.sh кладите НЕ сюда, а в отдельный
# /opt/tg-bot/.deploy.env (root:root, chmod 600), строкой GITHUB_TOKEN=...
# (fine-grained PAT, Contents: Read на репозиторий бота): этот файл systemd
# грузит в окружение бота, и токен стал бы виден агенту.
